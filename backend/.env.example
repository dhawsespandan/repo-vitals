# ─────────────────────────────────────────────────────────────────────────────
#  RepoVitals backend configuration  —  the executable copy of §6.
#  Copy to `.env` and fill in. Never commit `.env`.
#  Each entry is annotated with the phase that introduced it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Phase 1 · Core ──────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Dev: the docker-compose `db` service. Prod: the Supabase connection string.
# Research machine: point this at the *research* Postgres (port 5433, D8).
DATABASE_URL=postgres://repovitals:repovitals@localhost:5432/repovitals

# ── Phase 1 · Identity ──────────────────────────────────────────────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this invalidates every stored GitHub token; users simply re-login.
TOKEN_ENCRYPTION_KEY=

# Separate OAuth apps for dev and prod. Authorization callback URL:
#   dev   http://localhost:8000/api/auth/github/callback/
#   prod  https://<render-service>.onrender.com/api/auth/github/callback/
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Where the SPA lives. Used for the post-login redirect and as a CSRF trusted
# origin. Dev: the Vite dev server. Prod: the Vercel deployment URL.
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
#  Not yet used — listed so §6 and this file never drift apart.
# ─────────────────────────────────────────────────────────────────────────────
# Phase 4  · active weights file in backend/weights/
# WEIGHTS_VERSION=v1
#
# Phase 7  · generator LLM (temperature 0, JSON mode)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Phase 8  · retrieval
# CHROMA_DIR=.chroma
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# GROUNDING_MIN_SIM=0.30
# GROUNDING_MIN_CHARS=400
#
# Phase 11 · research commands only; never used for a user-facing scan
# GITHUB_API_PAT=
#
# Phase 12 · optional
# EPSS_ENABLED=false
# NVD_API_KEY=
#
# Phase 13 · judge LLM — must be a different provider from the generator (D11)
# GEMINI_API_KEY=
# JUDGE_MODEL=gemini-2.0-flash
